# FrankenPHP Caddyfile for production
# https://frankenphp.dev

{
    # Global options
    admin off
    persist_config false
    
    # Logging
    log {
        output stdout
        format json
        level INFO
    }
}

# HTTP server - redirect to HTTPS
http://vibe.playerinlife.ru {
    redir https://vibe.playerinlife.ru{uri} permanent
}

# HTTPS server
https://vibe.playerinlife.ru {
    # Automatic SSL with Let's Encrypt
    tls {
        email admin@playerinlife.ru
    }
    
    # Root directory
    root /var/www/html/public
    
    # PHP handling via FrankenPHP
    php_server
    
    # Static files
    file_server
    
    # Try files for SPA/routing
    try_files {path} {path}/ /index.php{query}
    
    # Security headers
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
    
    # Gzip compression
    encode gzip
    
    # Laravel maintenance mode
    @maintenance {
        file /var/www/html/storage/framework/maintenance.php
    }
    handle @maintenance {
        rewrite * /index.php
    }
}
